{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/(favicon\\.png|apple-touch-icon\\.png|icon-[0-9]+\\.png|madhav-[a-z0-9-]+\\.png|manifest\\.json|sw\\.js)",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
